# Agent Behavior
AGENT_NICHES=technology,saas,ai
AGENT_CYCLE_HOURS=6
CONTENT_AUTO_PUBLISH=false
CONTENT_MIN_WORDS=1500
CONTENT_MAX_WORDS=3000

# Publishing Configs (Optional)
