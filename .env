# Database
DATABASE_URL=sqlite://agent.db

# Limits
DAILY_CONTENT_LIMIT=5
DAILY_GEMINI_LIMIT=200

# Crawler
USER_AGENT=AEOAgent/1.0
CRAWL_DELAY=1
CRAWL_TIMEOUT=30
MAX_DEPTH=3
MAX_PAGES=100

# Server
PORT=8080
LOG_LEVEL=info
API_KEY=your_secret_api_key_here
