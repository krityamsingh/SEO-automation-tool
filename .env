# AI Multi-Provider API Key Pool (Base64 Encoded for 14 keys: Gemini, Kimi, MiniMax)
GEMINI_API_KEYS=""

GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Agent Behavior
AGENT_NICHES=technology,saas,ai
AGENT_CYCLE_HOURS=6
CONTENT_AUTO_PUBLISH=false
CONTENT_MIN_WORDS=1500
CONTENT_MAX_WORDS=3000

# Publishing Configs (Optional)
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=your_app_password
MEDIUM_INTEGRATION_TOKEN=your_medium_token
GHOST_URL=https://your-ghost-site.com
GHOST_ADMIN_API_KEY=your_ghost_key_id:your_ghost_secret_hex
WEBHOOK_URL=https://your-webhook.com/publish

# Database
DATABASE_URL=sqlite://agent.db

# Limits
DAILY_CONTENT_LIMIT=5
DAILY_GEMINI_LIMIT=200

# Crawler
USER_AGENT=AEOAgent/1.0
CRAWL_DELAY=1
CRAWL_TIMEOUT=30
MAX_DEPTH=3
MAX_PAGES=100

# Server
PORT=8080
LOG_LEVEL=info
API_KEY=your_secret_api_key_here
